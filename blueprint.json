{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"features": {
		"networking": true
	},
	"preferredVersions": {
	"php": "8.0",   
	"wp": "latest" 
	},
	"login": true,
	"siteOptions": {
		"permalink_structure": "/%postname%/"
	},
	"landingPage": "/wp-admin/?welcome=0",
	"steps": [
		{
			"step": "updateUserMeta",
			"meta": {
				"admin_color": "modern"
			},
			"userId": 1
		},
		{
			"step": "installTheme",
			"themeData": {
               		   "resource": "wordpress.org/themes",
               		   "slug": "twentytwentyfour"
           		}
		},
		{
			"step": "mkdir",
			"path": "/wordpress/wp-content/plugins/hellodashboard"
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/plugins/hellodashboard/hellodashboard.php",
			"data": {
			    "resource": "url",
			    "url": "https://github.com/wptrainingteam/hellodashboard/blob/main/hellodashboard.php"
				}
		},
		{
			"step": "activatePlugin",
			"pluginPath": "hellodashboard/hellodashboard.php"
		},
      		  {
			"step": "importWxr",
			"file": {
			    "resource": "url",
			    "url": "https://github.com/wptrainingteam/hellodashboard/blob/main/playgroundguide.xml"
			}
		}
	]
}
